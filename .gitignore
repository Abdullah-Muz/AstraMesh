# =====================================================================
# AstraMesh .gitignore
# Large raw datasets, experiment outputs, local tooling state, and any
# credentials must never be committed. See ASTRAMESH_MASTER_SPEC.md §8.2.
# =====================================================================

# --- Python bytecode / build artifacts --------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# --- Virtual environments ---------------------------------------------
.venv/
venv/
env/
ENV/
.python-version.local
__pypackages__/
# NOTE: uv.lock is intentionally NOT ignored (reproducible environments).

# --- Test, coverage, type-check, and lint caches ----------------------
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json
dmypy.json
.benchmarks/
.cache/

# --- Jupyter ------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Datasets (keep raw/large data out of Git) ------------------------
# Local data lives under data/; only small, documented, explicitly
# un-ignored files (e.g. README/registry stubs) may be committed.
data/*
!data/README.md
!data/.gitkeep
*.nc
*.nc4
*.cdf
*.h5
*.hdf5
*.hdf
*.parquet
*.feather
*.arrow
*.npy
*.npz
*.pkl
*.pickle
*.joblib
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz
*.bz2
*.xz
.dvc/cache/
.dvc/tmp/

# --- Experiment artifacts / run outputs -------------------------------
results/
outputs/
runs/
artifacts/
mlruns/
mlartifacts/
wandb/
lightning_logs/
checkpoints/
experiments/**/output/
experiments/**/outputs/
experiments/**/results/
# Recorded, reviewed experiment results (small CSV/JSON/Markdown) are committed:
!docs/results/
*.jsonl.gz
*.log
*.ckpt
*.pt
*.pth
*.onnx

# --- Basilisk / visualization outputs ---------------------------------
*.bin
_VizFiles/

# --- Local credentials and secrets ------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
.netrc
_netrc
.git-credentials
credentials.json
secrets.*
*.secret
*.token
.cdsapirc
.earthdatarc

# --- Claude Code local (per-user, never commit) -----------------------
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md

# --- VS Code ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.history/

# --- Other editors / IDEs ---------------------------------------------
.idea/
*.swp
*.swo
*~

# --- OS files: Windows, WSL2, macOS -----------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*:Zone.Identifier
.DS_Store

# --- OneDrive / sync conflict files -----------------------------------
*-DESKTOP-*.*
~$*
